{
  "name": "@zensen/form-service",
  "version": "2.1.1",
  "license": "MIT",
  "description": "A reactive form service framework",
  "main": "build/index.js",
  "module": "dist/form-service.esm.js",
  "unpkg": "dist/form-service.umd.min.js",
  "jsdelivr": "dist/form-service.umd.min.js",
  "author": "Travis True <travis.true08@gmail.com> (http://www.travistrue.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travistrue2008/zensen-form-service.git"
  },
  "engines": {
    "node": ">=8.5"
  },
  "scripts": {
    "build": "babel src -d build",
    "build:umd": "rollup -c",
    "build:all": "bun run build && bun run build:umd",
    "docs": "cd docs && bundle exec jekyll serve",
    "docs:dev": "cd docs && jekyll serve --livereload",
    "install:clear": "rm -rf node_modules",
    "lint": "eslint --fix",
    "prepublishOnly": "bun run build:all",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "form",
    "lit",
    "service",
    "react",
    "reactive",
    "zen",
    "zensen"
  ],
  "devDependencies": {
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.8.3",
    "@babel/preset-env": "^7.8.3",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/bun": "^1.4.2",
    "@zen-web-components/eslint-config": "^1.0.3",
    "eslint": "^5.16.0",
    "rollup": "^2.70.0",
    "validator": "^13.1.1"
  }
}
